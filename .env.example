# PixelGen Environment Configuration
# Copy this file to .env and fill in your API keys

# Pollinations API Key (optional - has free tier)
# Get your key from: https://pollinations.ai
POLLINATIONS_API_KEY=

# Notes:
# - The application works without any API key (free tier, per-IP rate limits).
# - The CLI (bin/pixegen.js) and MCP server (bin/pixegen-mcp.js) read this
#   same variable from the environment (they call gen.pollinations.ai
#   directly, no dev-server proxy involved).
# - Pollinations is the default backend (re-sells OpenAI GPT Image, Google
#   Gemini, and others through one API); the OpenAI key below enables direct
#   BYOK access as a fallback. See docs/PROVIDERS.md for the rationale and
#   its §2 revision note.

# Generation request timeout in milliseconds (optional, default 120000).
# Large sheet/tileset strips on a busy day can exceed two minutes.
# PIXEGEN_TIMEOUT_MS=300000

# OpenAI API Key (optional, bring-your-own-key)
# Enables direct OpenAI models (openai:gpt-image-1, openai:gpt-image-1-mini)
# in the CLI/MCP and — for single sprites — in the browser picker (the dev
# server calls OpenAI server-side; the key never reaches the client).
# Billed to your OpenAI account. Immune to Pollinations queue/outages.
# OPENAI_API_KEY=
